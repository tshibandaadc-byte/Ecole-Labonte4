DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecole_la_bonte

JWT_SECRET=change_moi_en_une_longue_chaine_aleatoire_en_prod
JWT_EXPIRES_MINUTES=10080

# "dev" (par défaut) ou "prod". En "prod", le serveur refuse de démarrer si
# JWT_SECRET ou CORS_ORIGINS sont encore aux valeurs par défaut ci-dessus.
ENVIRONMENT=dev

# Domaines autorisés à appeler cette API, séparés par des virgules.
# Exemple pour la production :
# CORS_ORIGINS=https://etudiant.labonte-ecole.ac,https://pay.labonte-ecole.ac
CORS_ORIGINS=http://localhost:3000
